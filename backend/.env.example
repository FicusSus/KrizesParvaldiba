# Crisis Prediction Backend Configuration
# Copy this file to .env and adjust the values for your environment

# Application
APP_NAME="Crisis Prediction Backend"
APP_VERSION="0.1.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL recommended)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crisis_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis (Optional - for caching and background jobs)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Security (JWT Authentication)
# Generate a new secure key for production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:8080

# Data Processing
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./ml/models
CHUNK_SIZE=10000
MAX_MEMORY_USAGE=0.8

# ML Models
MODEL_SAVE_PATH=./ml/models
FEATURES_DIR=./ml/features

# Notifications
# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=password
SMTP_FROM=no-reply@example.com

# Twilio for SMS (optional)
# Get from https://www.twilio.com/
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
