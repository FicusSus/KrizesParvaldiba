# Crisis Prediction Frontend Configuration
# Copy this file to .env and adjust the values for your environment

# Application
VITE_APP_NAME="Crisis Prediction"
VITE_APP_VERSION="0.1.0"
VITE_DEBUG=true

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=/api/v1

# Authentication
# JWT token storage (default: localStorage)
VITE_AUTH_STORAGE=localStorage

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Theme
VITE_THEME=light

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100
